# Variables used by docker-compose.yml only (copy to ".env" next to it).
# For local development use backend/.env instead (see backend/.env.example).

# Required. Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# Public address of the web app (used for CORS and e-mail links)
CLIENT_URL=http://localhost:8080
WEB_PORT=8080

# Optional - Google Gemini (receipt reading + AI insights). Empty = demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional - SMTP. Empty = e-mails are only logged and e-mail verification is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartHome <no-reply@smarthome.local>

# Optional - Google sign-in. Redirect URI: <CLIENT_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
