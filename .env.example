PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/smarthome
# Generate long random values for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Used for CORS and for links in emails (password reset)
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Optional: email. Without SMTP, emails (including OTP codes) are printed to the server console.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=SmartHome <noreply@localhost>

# Optional: receipt scanning (Google Gemini) - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Google login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
