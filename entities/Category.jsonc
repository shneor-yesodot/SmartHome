{

  "name": "Category",

  "type": "object",

  "properties": {

    "name": {

      "type": "string"

    },

    "type": {

      "type": "string",

      "enum": [

        "income",

        "expense"

      ]

    },

    "icon": {

      "type": "string"

    },

    "color": {

      "type": "string"

    },

    "budget_limit": {

      "type": "number"

    }

  },

  "required": [

    "name",

    "type"

  ],

  "rls": {

    "read": {

      "created_by_id": "{{user.id}}"

    },

    "create": {

      "created_by_id": "{{user.id}}"

    },

    "update": {

      "created_by_id": "{{user.id}}"

    },

    "delete": {

      "created_by_id": "{{user.id}}"

    }

  }

}