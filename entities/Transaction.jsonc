{

  "name": "Transaction",

  "type": "object",

  "properties": {

    "type": {

      "type": "string",

      "enum": [

        "income",

        "expense"

      ]

    },

    "amount": {

      "type": "number"

    },

    "category": {

      "type": "string"

    },

    "description": {

      "type": "string"

    },

    "merchant": {

      "type": "string"

    },

    "date": {

      "type": "string",

      "format": "date"

    },

    "receipt_url": {

      "type": "string"

    },

    "is_recurring": {

      "type": "boolean",

      "default": false

    },

    "tags": {

      "type": "array",

      "items": {

        "type": "string"

      }

    },

    "notes": {

      "type": "string"

    }

  },

  "required": [

    "type",

    "amount",

    "category",

    "date"

  ],

  "rls": {

    "read": {

      "created_by_id": "{{user.id}}"

    },

    "create": {

      "created_by_id": "{{user.id}}"

    },

    "update": {

      "created_by_id": "{{user.id}}"

    },

    "delete": {

      "created_by_id": "{{user.id}}"

    }

  }

}