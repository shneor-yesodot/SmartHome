# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Network interface to listen on. Empty = all. SmartHome.exe sets 127.0.0.1 (this computer only).
HOST=
# Set by SmartHome.exe: stop cleanly when the launcher window closes. Leave empty otherwise.
STOP_WITH_LAUNCHER=
# Comma-separated list of allowed frontend origins (CORS). The first one is used in e-mail links.
CLIENT_URL=http://localhost:5173

# ---------- Database ----------
# Leave empty in development: an embedded MongoDB starts automatically
# (data in backend/.data, Compass: mongodb://127.0.0.1:27018).
# Set it for a real server, e.g. MongoDB Atlas or mongodb://127.0.0.1:27017/smarthome
MONGO_URI=
EMBEDDED_MONGO_PORT=27018

# ---------- Auth ----------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Encrypts the authenticator secrets in the database. Generate like the secrets above.
# Changing it later makes existing two-factor setups unreadable.
ENCRYPTION_KEY=change-me-encryption

# ---------- Who may get in ----------
# Comma-separated addresses that may open an account (also through Google).
# Empty = registration is closed in production and open in development.
ALLOWED_EMAILS=
# How many reverse proxies are in front of the app (for the real client IP in rate limits)
TRUST_PROXY=1

# ---------- External service: Google Sheets sync (optional) ----------
# A service account's JSON key, as one line or base64. See the README.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---------- Single-container deployment ----------
# Folder of the built React app when the API serves it (set by the root Dockerfile)
FRONTEND_DIR=

# ---------- External API: Google Gemini (receipt reading + AI insights) ----------
# Get a key at https://aistudio.google.com/apikey . Without a key the app runs in demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ---------- External service: e-mail (SMTP) ----------
# Without SMTP, e-mails are printed to the server log and new accounts skip e-mail verification.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=your address, SMTP_PASS=an app password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SmartHome <no-reply@smarthome.local>"

# ---------- External service: Google sign-in (optional) ----------
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI must be exactly GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ---------- Files & jobs ----------
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=8
ENABLE_JOBS=true
